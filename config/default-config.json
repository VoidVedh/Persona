{
  "ui": {
    "engine": "web",
    "debugInspector": false
  },
  "wallpaper": {
    "mode": "overlay",
    "image": "bundled"
  },
  "topBar": {
    "height": 44,
    "marginTop": 6,
    "marginSide": 10,
    "level": "statusBar"
  },
  "hud": {
    "primaryScreenOnly": true,
    "ambientAnimation": true,
    "fps": 24,
    "particles": 28,
    "calmOnBattery": true
  },
  "launcher": {
    "width": 980,
    "height": 560
  },
  "tiling": {
    "enabled": true,
    "algorithm": "dwindle",
    "splitRatio": 0.5,
    "gaps": {
      "outer": 12,
      "inner": 10
    },
    "snapBackOnDrag": true,
    "floatApps": [
      "com.apple.systempreferences",
      "com.apple.calculator",
      "dev.persona.mode"
    ]
  },
  "border": {
    "enabled": true,
    "style": "p3r",
    "width": 3,
    "cornerRadius": 16,
    "bracketLength": 28,
    "color": "#00d8ff",
    "pulse": true
  },
  "sound": {
    "enabled": true,
    "volume": 0.35
  },
  "showcase": {
    "closeOnExit": false
  },
  "terminal": {
    "preference": [
      "ghostty",
      "kitty",
      "wezterm",
      "alacritty",
      "terminal"
    ]
  },
  "hotkeys": {
    "launcher": "opt+space",
    "tile": "ctrl+opt+t",
    "toggleFloat": "ctrl+opt+f",
    "terminal": "ctrl+opt+return",
    "showcase": "ctrl+opt+s",
    "mute": "ctrl+opt+m",
    "panic": "ctrl+opt+cmd+q",
    "space1": "ctrl+opt+1",
    "space2": "ctrl+opt+2",
    "space3": "ctrl+opt+3",
    "space4": "ctrl+opt+4",
    "space5": "ctrl+opt+5"
  },
  "guardian": {
    "enabled": true,
    "hangSeconds": 15
  }
}
